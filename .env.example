# Copia este archivo a .env localmente y reemplaza los valores de ejemplo.
# No uses el host pooled (-pooler) para Flyway: DB_MIGRATION_URL debe ser directo.
DB_URL='jdbc:postgresql://HOST.neon.tech/NOMBRE_BD?sslmode=require&channel_binding=require'
DB_MIGRATION_URL='jdbc:postgresql://HOST_DIRECTO.neon.tech/NOMBRE_BD?sslmode=require'
DB_USER='usuario_ejemplo'
DB_PASSWORD='contraseña_ejemplo'
JWT_SECRET='CAMBIA_ESTE_VALOR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS'
